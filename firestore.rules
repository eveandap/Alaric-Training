rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // First-pass rules for the AP Baseball PWA.
    // Requires users to be authenticated (anonymous auth is acceptable).
    // This still uses a shared backup ID, so you may want to tighten rules later.
    match /apCloudBackups/{backupId} {
      allow read, write: if request.auth != null;

      match /athletes/{athleteId} {
        allow read, write: if request.auth != null;

        match /notificationEvents/{eventId} {
          allow read, write: if request.auth != null;
        }
      }

      match /notificationTokens/{tokenId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
